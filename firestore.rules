rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ---------- Funções ----------

    function signedIn() { return request.auth != null; }

    // Criança: aparelho com login anônimo (pareado por QR). Nunca tem e-mail.
    function isAnon() {
      return signedIn() && request.auth.token.firebase.sign_in_provider == 'anonymous';
    }

    // Adulto: conta com e-mail verificado (Google já vem verificado).
    function isAdult() {
      return signedIn() && !isAnon() && request.auth.token.email_verified == true;
    }

    // Administrador (painel web). Só este e-mail aprova contas.
    function isAdmin() {
      return signedIn() && request.auth.token.email == 'tecnologiconatan@gmail.com'
             && request.auth.token.email_verified == true;
    }

    function familyDoc(fid) {
      return get(/databases/$(database)/documents/families/$(fid));
    }

    function isMember(fid) {
      return signedIn() && request.auth.uid in familyDoc(fid).data.members;
    }

    function childDoc(fid, cid) {
      return get(/databases/$(database)/documents/families/$(fid)/children/$(cid));
    }

    // O aparelho autenticado agora é o aparelho pareado com esta criança?
    function isChildDevice(fid, cid) {
      return isAnon() && childDoc(fid, cid).data.deviceUid == request.auth.uid;
    }

    // ---------- Perfil do adulto ----------
    // O campo "aprovado" nasce falso e só o administrador muda.
    match /users/{uid} {
      allow read: if (signedIn() && request.auth.uid == uid) || isAdmin();
      allow create: if isAdult() && request.auth.uid == uid
                    && request.resource.data.keys().hasOnly(['email', 'name', 'aprovado', 'createdAt'])
                    && request.resource.data.aprovado == false
                    && request.resource.data.email == request.auth.token.email.lower();
      allow update: if isAdmin();
      allow delete: if false;
    }

    // ---------- Família ----------
    match /families/{fid} {
      allow read: if (signedIn() && request.auth.uid in resource.data.members) || isAdmin();

      // Só adulto aprovado cria família, e entra como único membro/dono.
      allow create: if isAdult()
                    && request.resource.data.keys().hasOnly(['name', 'ownerUid', 'members', 'memberNames', 'createdAt'])
                    && request.resource.data.ownerUid == request.auth.uid
                    && request.resource.data.members == [request.auth.uid]
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.aprovado == true
                    && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('bloqueado', false) == false;

      allow update: if
        // qualquer responsável renomeia a família
        (signedIn() && request.auth.uid in resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name']))
        // o dono gerencia os responsáveis (remover) e continua sendo dono
        || (signedIn() && resource.data.ownerUid == request.auth.uid
          && request.resource.data.ownerUid == resource.data.ownerUid
          && request.auth.uid in request.resource.data.members
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'members', 'memberNames']))
        // o convidado entra sozinho, mas só com convite para o e-mail dele (verificado)
        || (isAdult()
          && !(request.auth.uid in resource.data.members)
          && request.auth.uid in request.resource.data.members
          && request.resource.data.members.size() == resource.data.members.size() + 1
          && request.resource.data.members.hasAll(resource.data.members)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members', 'memberNames'])
          && exists(/databases/$(database)/documents/invites/$(fid + '_' + request.auth.token.email.lower())));

      allow delete: if false;

      // ---------- Crianças ----------
      match /children/{cid} {
        allow read: if isMember(fid) || isChildDevice(fid, cid);

        allow create: if isMember(fid)
                      && request.resource.data.keys().hasOnly(['name', 'emoji', 'familyName', 'deviceUid', 'pairedAt', 'createdAt'])
                      && request.resource.data.deviceUid == null;

        allow update: if isMember(fid)
          // pareamento: o aparelho da criança assume o perfil com um QR válido, de uso único
          || (isAnon()
              && resource.data.deviceUid == null
              && request.resource.data.deviceUid == request.auth.uid
              && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deviceUid', 'pairedAt', 'pairToken'])
              && get(/databases/$(database)/documents/pairTokens/$(request.resource.data.pairToken)).data.familyId == fid
              && get(/databases/$(database)/documents/pairTokens/$(request.resource.data.pairToken)).data.childId == cid
              && get(/databases/$(database)/documents/pairTokens/$(request.resource.data.pairToken)).data.expiresAt > request.time
              && !existsAfter(/databases/$(database)/documents/pairTokens/$(request.resource.data.pairToken)));

        allow delete: if isMember(fid);

        // Localização: só o aparelho pareado escreve; só os responsáveis e ele leem.
        match /live/{doc} {
          allow write: if isChildDevice(fid, cid);
          allow read: if isMember(fid) || isChildDevice(fid, cid);
        }
      }
    }

    // ---------- Códigos (QR) de pareamento ----------
    // O token é aleatório (24 caracteres) e vale 15 min. Ninguém consegue listar.
    match /pairTokens/{token} {
      allow get: if false;
      allow list: if false;
      allow create: if isAdult() && isMember(request.resource.data.familyId)
                    && request.resource.data.keys().hasOnly(['familyId', 'childId', 'createdBy', 'expiresAt'])
                    && request.resource.data.createdBy == request.auth.uid
                    && request.resource.data.expiresAt > request.time
                    && request.resource.data.expiresAt < request.time + duration.value(30, 'm');
      allow delete: if isMember(resource.data.familyId)
                    || (isAnon()
                        && getAfter(/databases/$(database)/documents/families/$(resource.data.familyId)/children/$(resource.data.childId)).data.deviceUid == request.auth.uid);
    }

    // ---------- Convites para outro adulto ----------
    // Documento: invites/{familyId}_{email em minúsculas}
    match /invites/{inviteId} {
      allow read: if signedIn()
                  && (isMember(resource.data.familyId)
                      || (isAdult() && resource.data.email == request.auth.token.email.lower()));
      allow create: if isAdult() && isMember(request.resource.data.familyId)
                    && request.resource.data.keys().hasOnly(['familyId', 'familyName', 'email', 'invitedByUid', 'invitedByName', 'createdAt'])
                    && request.resource.data.invitedByUid == request.auth.uid
                    && request.resource.data.email == request.resource.data.email.lower()
                    && inviteId == request.resource.data.familyId + '_' + request.resource.data.email;
      allow delete: if signedIn()
                    && (isMember(resource.data.familyId)
                        || (isAdult() && resource.data.email == request.auth.token.email.lower()));
      allow update: if false;
    }

    // ---------- Administrador: leitura de tudo (painel) ----------
    match /{path=**}/children/{doc} {
      allow read: if isAdmin();
    }
    match /{path=**}/live/{doc} {
      allow read: if isAdmin();
    }
  }
}
